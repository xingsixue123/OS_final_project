diff -ruN '--exclude=.git' '--exclude=__pycache__' ../../0_reproduce/baleen_code/BCacheSim/cachesim/load_features.py overlay/BCacheSim/cachesim/load_features.py
--- ../../0_reproduce/baleen_code/BCacheSim/cachesim/load_features.py	1969-12-31 19:00:00.000000000 -0500
+++ overlay/BCacheSim/cachesim/load_features.py	2026-10-01 14:41:07.471895775 -0400
@@ -0,0 +1,147 @@
+"""PeakBaleen phase-2 overlay (changes/SCOPE_v2.md section 1): causal demand-side load features.
+
+Feature groups (enabled through the existing '+'-joined feature-subset strings; the defaults never use them):
+  load  trailing demand-side disk-head time over the last 10, 30 and 60 minutes before an access: the no-cache
+        service time service_time(1, #chunks) (the artifact's own DT model, i.e. exactly what the simulator
+        accumulates as `service_time_nocache`) of every GET request of the trace with timestamp STRICTLY EARLIER
+        than the access, normalised to utilisation % with the artifact's own st_to_util (sampling ratio, 36 disks,
+        window length) -- the same units as PeakServiceTimeUtil1. It depends only on the request stream (never on
+        admission decisions), so training and serving see identical values.
+  tod   hour of day (UTC, from the trace's physical timestamp) as [sin, cos].
+
+Training (episodic_analysis/train_ap.py, train_prefetcher.py) and serving (cachesim/sim_features.py,
+sim_cache.py, admission_policies.py) both build the series with DemandLoad.from_trace() from the same trace file
+(the artifact's own reader, legacy_utils.read_processed_file) and look it up with the same functions below, keyed
+by the access's physical timestamp.
+"""
+import math
+import os
+
+import numpy as np
+
+from . import legacy_utils
+from ..episodic_analysis.episodes import service_time
+from ..episodic_analysis.episodes import st_to_util
+
+LOAD_WINDOWS_S = (600, 1800, 3600)
+EXTRA_GROUP_SIZES = {'load': len(LOAD_WINDOWS_S), 'tod': 2}
+# Feature names used by the prefetch models (train_prefetcher.feat_names) for the extra groups.
+PF_FEAT_NAMES = {'load': [f'load_{w // 60}m' for w in LOAD_WINDOWS_S], 'tod': ['tod_sin', 'tod_cos']}
+# Load-adaptive admission threshold: g(load) = clip((load / ref) ** alpha, *LOAD_ADAPT_CLIP).
+LOAD_ADAPT_CLIP = (0.25, 4.0)
+
+
+def extra_groups(feat_subset):
+    """Ordered list of overlay feature groups ('load', 'tod') named in a '+'-joined feature-subset string."""
+    if not feat_subset:
+        return []
+    return [g for g in feat_subset.split('+') if g in EXTRA_GROUP_SIZES]
+
+
+class DemandLoad(object):
+    """Cumulative GET demand of a trace, looked up by physical timestamp (strictly causal: ts < t)."""
+
+    def __init__(self, ts, nchunks, sample_ratio):
+        order = np.argsort(np.asarray(ts, dtype=float), kind='stable')
+        self.ts = np.asarray(ts, dtype=float)[order]
+        nchunks = np.asarray(nchunks, dtype=np.int64)[order]
+        self.cum_chunks = np.concatenate([[0], np.cumsum(nchunks, dtype=np.int64)])
+        self.sample_ratio = sample_ratio
+        self._last = (None, None)
+
+    @classmethod
+    def from_trace(cls, tracefile, sample_ratio):
+        k_accesses, _, _ = legacy_utils.read_processed_file(tracefile, get_features=True, only_gets=True)
+        ts, nchunks = [], []
+        for kacc in k_accesses.values():
+            for acc in kacc.accesses:
+                ts.append(acc.ts)
+                nchunks.append(acc.num_chunks())
+        print(f"DemandLoad: {len(ts)} GET requests from {tracefile} (sample_ratio={sample_ratio})")
+        return cls(ts, nchunks, sample_ratio)
+
+    def window_st(self, t, window_s):
+        """No-cache GET service time (s) of the requests with t - window_s <= ts < t."""
+        hi = int(np.searchsorted(self.ts, t, side='left'))
+        lo = int(np.searchsorted(self.ts, t - window_s, side='left'))
+        return service_time(hi - lo, int(self.cum_chunks[hi] - self.cum_chunks[lo]))
+
+    def load(self, t):
+        """[load_10m, load_30m, load_60m] in utilisation % at physical time t (requests with ts < t only)."""
+        if self._last[0] != t:
+            self._last = (t, [st_to_util(self.window_st(t, w), sample_ratio=self.sample_ratio, duration_s=w) * 100
+                              for w in LOAD_WINDOWS_S])
+        return list(self._last[1])
+
+
+def tod(t):
+    """Hour of day (UTC) of physical timestamp t as [sin, cos]."""
+    a = 2 * math.pi * (t % 86400.0) / 86400.0
+    return [math.sin(a), math.cos(a)]
+
+
+def group_features(demand, group, t):
+    if group == 'load':
+        return demand.load(t)
+    if group == 'tod':
+        return tod(t)
+    raise NotImplementedError(group)
+
+
+def extra_features(demand, groups, t):
+    out = []
+    for g in groups:
+        out.extend(group_features(demand, g, t))
+    return out
+
+
+_DEMAND_CACHE = {}
+
+
+def demand_for_trace(tracefile, sample_ratio):
+    key = (os.path.realpath(tracefile), float(sample_ratio))
+    if key not in _DEMAND_CACHE:
+        _DEMAND_CACHE[key] = DemandLoad.from_trace(tracefile, sample_ratio)
+    return _DEMAND_CACHE[key]
+
+
+def demand_for_trace_kwargs(trace_kwargs):
+    """Training side: the same trace file the trainer reads (local_cluster.tracefilename, as trace_utils)."""
+    from ..episodic_analysis import local_cluster
+    f = local_cluster.tracefilename(sample_ratio=trace_kwargs['sample_ratio'], region=trace_kwargs['region'],
+                                    start=trace_kwargs.get('start', 0), trace_group=trace_kwargs.get('trace_group'))
+    return demand_for_trace(f, trace_kwargs['sample_ratio'])
+
+
+def check_admission_feature_names(names, feat_subset):
+    """Serving-side guard: the model's columns for each overlay group sit exactly where collect_features puts them."""
+    from .sim_features import count_feat
+    pos = 0
+    for g in feat_subset.split('+'):
+        n = count_feat(g)
+        if g in EXTRA_GROUP_SIZES:
+            want = [f'feat_{g}|{i}' for i in range(n)]
+            assert list(names[pos:pos + n]) == want, (feat_subset, pos, list(names), want)
+        pos += n
+    assert pos == len(names), (feat_subset, list(names))
+
+
+class LoadAdaptiveThreshold(object):
+    """theta_t = theta * g(load_t), g(x) = clip((max(x, 1e-6) / ref) ** alpha, 0.25, 4); load_t = trailing demand
+    load (window_min minutes) at the access time. alpha is the fixed shape parameter (alpha < 0: lower threshold,
+    i.e. admit more, when demand is high)."""
+
+    def __init__(self, demand, alpha, ref=20.0, window_min=10):
+        assert window_min * 60 in LOAD_WINDOWS_S, window_min
+        self.demand = demand
+        self.alpha = float(alpha)
+        self.ref = float(ref)
+        self.idx = LOAD_WINDOWS_S.index(window_min * 60)
+        self.window_min = window_min
+
+    def g(self, t):
+        x = max(self.demand.load(t)[self.idx], 1e-6)
+        return min(max((x / self.ref) ** self.alpha, LOAD_ADAPT_CLIP[0]), LOAD_ADAPT_CLIP[1])
+
+    def __repr__(self):
+        return f"LoadAdaptiveThreshold(alpha={self.alpha}, ref={self.ref}, window={self.window_min}m, clip={LOAD_ADAPT_CLIP})"
