+
+class LoadTableThreshold(object):
+    """PeakBaleen overlay v3 (SCOPE_v2_1b): theta_t = theta * g(load_t[, hour_t]) with g a piecewise-constant table.
+    JSON: {"window_min": 10, "edges": [e_1 < ... < e_{K-1}] (load_t in utilisation %), "mult": [m_0..m_{K-1}]}, load
+    bucket b = bisect_right(edges, load_t) (bucket b covers e_b <= load_t < e_{b+1}); optional time-of-day cells:
+    "tod_edges_h": [h_1 < ... < h_{J-1}] (UTC hour of day) and "mult": J lists of K values. load_t is the same causal
+    trailing GET demand as LoadAdaptiveThreshold (DemandLoad.load)."""
+
+    def __init__(self, demand, edges, mult, window_min=10, tod_edges_h=None, name=None):
+        assert window_min * 60 in LOAD_WINDOWS_S, window_min
+        self.demand = demand
+        self.edges = [float(e) for e in edges]
+        assert all(a < b for a, b in zip(self.edges, self.edges[1:])), "edges must increase"
+        self.tod_edges_h = None if tod_edges_h is None else [float(h) for h in tod_edges_h]
+        mult = [list(map(float, r)) for r in mult] if self.tod_edges_h is not None else [list(map(float, mult))]
+        assert len(mult) == (1 if self.tod_edges_h is None else len(self.tod_edges_h) + 1), "tod rows"
+        assert all(len(r) == len(self.edges) + 1 for r in mult), "one multiplier per load bucket"
+        assert all(m > 0 for r in mult for m in r), "multipliers must be positive"
+        self.mult = mult
+        self.idx = LOAD_WINDOWS_S.index(window_min * 60)
+        self.window_min = window_min
+        self.name = name
+
+    @classmethod
+    def from_json(cls, demand, path):
+        d = json.load(open(path))
+        return cls(demand, d["edges"], d["mult"], window_min=d.get("window_min", 10),
+                   tod_edges_h=d.get("tod_edges_h"), name=d.get("name", os.path.basename(path)))
+
+    def g(self, t):
+        b = bisect.bisect_right(self.edges, self.demand.load(t)[self.idx])
+        j = 0 if self.tod_edges_h is None else bisect.bisect_right(self.tod_edges_h, (t % 86400.0) / 3600.0)
+        return self.mult[j][b]
+
+    def __repr__(self):
+        return (f"LoadTableThreshold(name={self.name}, window={self.window_min}m, K={len(self.edges) + 1}, "
+                f"tod={'none' if self.tod_edges_h is None else len(self.tod_edges_h) + 1})")
